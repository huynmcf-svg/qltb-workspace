# qltb-workspace — copy sang .env rồi điền
# cp .env.example .env

# ── Sub-repo — đường dẫn tính từ thư mục workspace ─────────────
SERVICE_REPO=../qltb-service
WEB_REPO=../qltb-web

# ── Dev server ports ───────────────────────────────────────────
# Chọn 34xx để chạy song song với dự án khác trên cùng máy (pccc dùng 33xx).
SERVICE_PORT=3400
WEB_PORT=3401

# ── PostgreSQL local ───────────────────────────────────────────
# scripts/db-setup.sh dùng bộ này để tạo role + database trên Postgres local.
# Phải trùng với DB_* trong qltb-service/.env.
DB_HOST=localhost
DB_PORT=5432
DB_USER=qltb
DB_PASS=qltb_dev_2026
DB_NAME=qltb
